{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "//": "The RN glue (provider/native) is typechecked here too, using the react/react-native-webview devDeps. host-html.ts is generated; its type comes from host-html.d.ts.",
  "exclude": ["src/host-html.ts"]
}
