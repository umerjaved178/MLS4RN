{
  "name": "mls4rn-react-native",
  "version": "0.0.0",
  "description": "React Native support for mls4rn (OpenMLS) — runs the web build inside a hidden WebView",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "react-native": "./src/native.tsx",
  "types": "./dist/native.d.ts",
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build:host": "npm --prefix host run build",
    "embed": "node scripts/embed-host.mjs",
    "rn:host": "npm run build:host && npm run embed",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run rn:host && npm run build:types",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "mls4rn": "file:../..",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-webview": "13.12.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
