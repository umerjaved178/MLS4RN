{
  "name": "mls4rn",
  "version": "0.2.0",
  "description": "End-to-end encrypted group messaging for React Native, using the MLS protocol (RFC 9420).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umerjaved178/MLS4RN.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/umerjaved178/MLS4RN/tree/main/packages/react-native#readme",
  "bugs": "https://github.com/umerjaved178/MLS4RN/issues",
  "main": "./src/index.ts",
  "react-native": "./src/native.tsx",
  "types": "./dist/native.d.ts",
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build:host": "npm --prefix host run build",
    "embed": "node scripts/embed-host.mjs",
    "rn:host": "npm run build:host && npm run embed",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run rn:host && npm run build:types",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "mls-ts": "file:../..",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-webview": "13.12.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
